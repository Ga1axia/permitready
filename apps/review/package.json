{
  "name": "review",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-web-ifc-wasm.mjs && node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-web-ifc-wasm.mjs && node scripts/copy-pdf-worker.mjs",
    "postinstall": "node scripts/copy-web-ifc-wasm.mjs && node scripts/copy-pdf-worker.mjs",
    "samples": "node scripts/fetch-samples.mjs",
    "references": "node scripts/fetch-references.mjs",
    "drawings": "python3 scripts/make_drawings.py",
    "index-references": "python3 scripts/index_references.py",
    "check": "python3 scripts/check_code.py",
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "lint": "biome lint",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@pascal-app/core": "*",
    "@pascal-app/ifc-converter": "*",
    "@pascal-app/nodes": "*",
    "@pascal-app/viewer": "*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pdfjs-dist": "^5.4.149",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78",
    "zustand": "^5"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "7.0.2"
  }
}
